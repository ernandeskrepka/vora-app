# ---------------------------------------------------------------------------
# VORA - sistema de aprovacao e publicacao. Copie para .env e preencha.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Banco e fila -----------------------------------------------------------
# Postgres (Supabase, Neon, RDS ou local).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/vora_aprovacao?schema=public"
# Redis para a fila (BullMQ). No Railway/Render use a URL do add-on.
REDIS_URL="redis://127.0.0.1:6379"

# --- Aplicacao --------------------------------------------------------------
# Base publica. Entra nos links de aprovacao enviados por WhatsApp,
# por isso precisa ser o endereco que o cliente acessa.
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/Sao_Paulo"

# Chave de 32 bytes em base64. Gere com:  openssl rand -base64 32
# Usada para (1) cifrar os tokens da Meta e (2) derivar os tokens dos links
# de aprovacao. ATENCAO: trocar essa chave invalida os links em aberto.
ENCRYPTION_KEY=""

# --- Armazenamento dos criativos -------------------------------------------
# local = disco (so desenvolvimento). s3 = Cloudflare R2 ou AWS S3.
# Em producao use s3: a Meta baixa a midia de uma URL publica.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

# Cloudflare R2: S3_ENDPOINT="https://<conta>.r2.cloudflarestorage.com"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Dominio publico do bucket (opcional). Sem ele, usamos URL assinada.
S3_PUBLIC_BASE_URL=""
S3_SIGNED_URL_TTL_SECONDS=3600

# --- Meta (Instagram + Paginas do Facebook) --------------------------------
# Versao fixada da Graph API. Atual em 13/10/2026: v26.0.
META_GRAPH_VERSION="v26.0"
META_APP_ID=""
META_APP_SECRET=""
# Token do System User do Business Manager da agencia (caminho preferido).
META_SYSTEM_USER_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
# true = simula a publicacao e nao chama a Meta. Mantenha true ate o
# App Review ser aprovado e as contas dos clientes estarem conectadas.
META_DRY_RUN=true
# Fallback do limite diario por conta do Instagram. O sistema consulta o
# limite real em /{ig-user-id}/content_publishing_limit antes de publicar.
META_IG_DAILY_LIMIT=100

# --- WhatsApp Cloud API ----------------------------------------------------
# log = nao envia nada, apenas registra (desenvolvimento e fase 2 do plano).
WHATSAPP_MODE=log
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_LANGUAGE="pt_BR"
WHATSAPP_TEMPLATE_APPROVAL="vora_aprovacao_pendente"
WHATSAPP_TEMPLATE_REMINDER="vora_aprovacao_lembrete"
WHATSAPP_TEMPLATE_PUBLISHED="vora_post_publicado"

# --- Notificacao interna da equipe -----------------------------------------
# log | whatsapp | slack  (tambem editavel na tela de Configuracoes)
INTERNAL_NOTIFY_CHANNEL=log
INTERNAL_NOTIFY_WHATSAPP_TO=""
SLACK_WEBHOOK_URL=""

# --- Regras operacionais ---------------------------------------------------
# Validade maxima do link de aprovacao (o link tambem morre no horario do post).
APPROVAL_TOKEN_TTL_HOURS=336
# Lembretes, em horas antes do horario do post (tela de Configuracoes manda).
REMINDER_OFFSETS_HOURS="24,2"
# Tentativas de publicacao por rede, com backoff exponencial.
PUBLISH_MAX_ATTEMPTS=3

# --- Observabilidade -------------------------------------------------------
SENTRY_DSN=""

# Senha inicial criada pelo seed de desenvolvimento.
SEED_SENHA="vora-piloto-2026"
