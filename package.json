{
  "name": "vora-aprovacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema interno da VORA para aprovacao do cliente e publicacao automatizada de criativos no Instagram e Facebook",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.14",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "^18.0.7",
    "ioredis": "6.0.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
